NODE_ENV=development
PORT=3001

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clinic_booking
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=replace-with-a-secret-at-least-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-secret-at-least-32-characters
JWT_REFRESH_EXPIRES_IN=7d

# CORS - comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Optional: bootstrap admin (parsed by env validation)
# SYSTEM_ADMIN_EMAIL=admin@example.com
# SYSTEM_ADMIN_PASSWORD=change-me-at-least-8-chars
# SYSTEM_ADMIN_NAME=Admin

# Optional: where avatar uploads are stored (defaults to uploads)
# UPLOAD_DIR=uploads