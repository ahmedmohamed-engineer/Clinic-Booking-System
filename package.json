{
  "name": "clinic-booking-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:avatar": "tsx --test src/services/avatar-storage.test.ts",
    "test:cors": "tsx --test src/config/cors.test.ts src/app.cors.test.ts",
    "test:powered-by": "tsx --test src/app.powered-by.test.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:test": "PGPASSWORD=postgres psql -h postgres -U postgres -d clinic_booking -f src/database/tests/database_validation.sql",
    "db:cleanup": "PGPASSWORD=postgres psql -h postgres -U postgres -d clinic_booking -f src/database/tests/cleanup.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
